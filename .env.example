# RazAgent_Trader env template.
# Real values live in Windows Credential Manager (keyring scope: RazAgentTrader).
# This file is ONLY for documentation / reference.

# --- LLM (Moonshot Kimi 2.5) ---
# MOONSHOT_API_KEY=sk-...         (keyring)
# MOONSHOT_ORG_ID=org-...          (keyring)
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-128k

# --- Supervisor bridge ---
# TAILSCALE_METRIC_TOKEN=...       (keyring, bearer for PC -> laptop metrics polling)
METRICS_PORT=9100
METRICS_HOST=0.0.0.0
ALLOWED_IPS=192.168.1.0/24

# --- Telegram ---
# TRADE_CRYPTO_BOT_TOKEN=...       (keyring, set after F3.1 BotFather revoke)
# TRADE_CRYPTO_CHAT_ID=...         (keyring)
TELEGRAM_MODE=polling

# --- Exchanges ---
# BINANCE_API_KEY + BINANCE_API_SECRET (keyring)
# KUCOIN_API_KEY + KUCOIN_API_SECRET + KUCOIN_API_PASSPHRASE (keyring)

# --- Safety ---
MAX_TRADE_USD=7
MAX_DAILY_LOSS_USD=20
PAPER_MODE=true
